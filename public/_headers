# Headers for static files (pages the Worker renders get the same from next.config.mjs).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff

/bloomboard-demo/*
  X-Robots-Tag: noindex

# Hero pictures never change under the same name (new pictures get a new folder),
# so browsers and the CDN can keep them for a year.
/backgrounds/hero-v1/*
  Cache-Control: public, max-age=31536000, immutable
